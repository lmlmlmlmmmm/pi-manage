{
  "name": "pi-manage",
  "version": "0.2.0",
  "description": "pi 本地配置管理：Provider、模型、独立 API Key 与默认设置，支持 pi 扩展和独立启动",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmlmlmlmmmm/pi-manage.git"
  },
  "homepage": "https://github.com/lmlmlmlmmmm/pi-manage#readme",
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "provider",
    "model",
    "config",
    "manager"
  ],
  "type": "module",
  "bin": {
    "pi-manage": "dist-server/server/entry.js"
  },
  "main": "dist-server/server/index.js",
  "pi": {
    "extensions": ["./extensions/pi-manage.js"]
  },
  "files": [
    "dist",
    "dist-server",
    "extensions",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:back": "tsc -p tsconfig.server.json --watch",
    "dev:back:run": "node --watch dist-server/server/entry.js",
    "start": "node dist-server/server/entry.js",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "naive-ui": "^2.43.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "typescript": "~5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.1.11",
    "vue-tsc": "^3.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
